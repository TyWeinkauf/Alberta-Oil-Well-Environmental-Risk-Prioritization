# Copy to .env and replace CHANGE_ME with your local PostgreSQL password.
# Managed cloud: source /workspace/alberta-environment/activate.sh instead.
# URL-encode special characters in a password; never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/alberta_risk

# Optional: absolute path to your verified source catalogue (API/download/local inputs).
# SOURCE_CATALOG_PATH=/absolute/path/to/catalog.yml
